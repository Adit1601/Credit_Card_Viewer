<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_nav"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.cardvault.ui.home.HomeFragment"
        android:label="home">
        <action
            android:id="@+id/action_home_to_add"
            app:destination="@id/addEditCardFragment" />
        <action
            android:id="@+id/action_home_to_detail"
            app:destination="@id/cardDetailFragment" />
        <action
            android:id="@+id/action_home_to_settings"
            app:destination="@id/settingsFragment" />
    </fragment>

    <fragment
        android:id="@+id/addEditCardFragment"
        android:name="com.cardvault.ui.addedit.AddEditCardFragment"
        android:label="add_edit">
        <argument
            android:name="cardId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <fragment
        android:id="@+id/cardDetailFragment"
        android:name="com.cardvault.ui.detail.CardDetailFragment"
        android:label="detail">
        <argument
            android:name="cardId"
            app:argType="string" />
        <action
            android:id="@+id/action_detail_to_edit"
            app:destination="@id/addEditCardFragment" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.cardvault.ui.settings.SettingsFragment"
        android:label="settings" />
</navigation>
