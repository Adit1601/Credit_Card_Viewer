<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_nav"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.cardvault.ui.home.HomeFragment"
        android:label="home">
        <action
            android:id="@+id/action_home_to_add"
            app:destination="@id/addEditCardFragment" />
        <action
            android:id="@+id/action_home_to_detail"
            app:destination="@id/cardDetailFragment" />
        <action
            android:id="@+id/action_home_to_settings"
            app:destination="@id/settingsFragment" />
        <action
            android:id="@+id/action_home_to_scan"
            app:destination="@id/cardScanFragment" />
    </fragment>

    <fragment
        android:id="@+id/addEditCardFragment"
        android:name="com.cardvault.ui.addedit.AddEditCardFragment"
        android:label="add_edit">
        <argument
            android:name="cardId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <action
            android:id="@+id/action_add_to_scan"
            app:destination="@id/cardScanFragment" />
    </fragment>

    <fragment
        android:id="@+id/cardDetailFragment"
        android:name="com.cardvault.ui.detail.CardDetailFragment"
        android:label="detail">
        <argument
            android:name="cardId"
            app:argType="string" />
        <action
            android:id="@+id/action_detail_to_edit"
            app:destination="@id/addEditCardFragment" />
    </fragment>

    <!--
      The scanner is a transient step, never a place the user should land on with Back. Both
      routes out of it (a successful scan, or "enter manually") pop it off the stack, so the
      Back button from the add form returns to wherever the scan was started from.
    -->
    <fragment
        android:id="@+id/cardScanFragment"
        android:name="com.cardvault.ui.scan.CardScanFragment"
        android:label="scan">
        <!--
          popUpTo the scanner *inclusive* so pressing Back on the add form does not drop the
          user back into a live camera they have already finished with. Only used when the scan
          was started from Home; if it was started from the add form, CardScanFragment pops
          instead of navigating, so the half-filled form the user came from is preserved.
        -->
        <action
            android:id="@+id/action_scan_to_add"
            app:destination="@id/addEditCardFragment"
            app:popUpTo="@id/cardScanFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.cardvault.ui.settings.SettingsFragment"
        android:label="settings" />
</navigation>
