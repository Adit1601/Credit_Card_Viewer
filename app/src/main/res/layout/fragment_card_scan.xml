<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_root"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:navigationContentDescription="@string/cd_back"
            app:title="@string/scan_title" />
    </com.google.android.material.appbar.AppBarLayout>

    <!--
      The camera half. Hidden as a unit whenever scanning is unavailable, so the fallback panel
      never has to sit on top of a dead PreviewView.
    -->
    <FrameLayout
        android:id="@+id/cameraGroup"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/appBar"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/scan_cd_preview"
            app:scaleType="fillCenter" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!--
              1.586:1 is the ID-1 card ratio, so lining the card up with the reticle also squares
              it to the sensor. Kept inside its own centred wrapper because a plain View with a
              dimensionRatio cannot be centred by FrameLayout gravity alone.
            -->
            <View
                android:id="@+id/reticle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_margin="24dp"
                android:background="@drawable/scan_reticle"
                app:layout_constraintDimensionRatio="H,1.586:1"
                app:layout_constraintWidth_max="480dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!--
              Torch sits over the preview rather than in the toolbar: it is a property of the
              camera, and the user's thumb is already down here. Hidden outright when the camera
              reports no flash unit.
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/torchButton"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/scan_cd_torch"
                android:visibility="gone"
                app:icon="@drawable/ic_torch_off"
                app:iconSize="24dp"
                tools:visibility="visible"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/scanHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                android:gravity="center"
                android:text="@string/scan_hint"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/reticle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!--
              Four independent ticks rather than a spinner or a percentage. A scan is not one
              opaque operation: fields lock one at a time and in any order, and showing which
              ones have landed is what tells the user whether to keep holding the card there or
              whether they are done. It is also the only honest way to present "Use what you
              have" — they can see exactly what "what you have" is.
            -->
            <LinearLayout
                android:id="@+id/checklist"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/scanHint"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/tickPan"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_check_circle"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/labelPan"
                        android:layout_width="match_parent"
                        android:gravity="center"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/scan_field_pan"
                        android:textSize="12sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/tickExpiry"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_check_circle"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/labelExpiry"
                        android:layout_width="match_parent"
                        android:gravity="center"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/scan_field_expiry"
                        android:textSize="12sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/tickName"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_check_circle"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/labelName"
                        android:layout_width="match_parent"
                        android:gravity="center"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/scan_field_name"
                        android:textSize="12sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/tickBank"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_check_circle"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/labelBank"
                        android:layout_width="match_parent"
                        android:gravity="center"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/scan_field_bank"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>

    <!--
      The unavailable-scanning panel: no permission, permission blocked in Settings, no camera
      hardware, the camera failed to open, or the scan timed out without reading anything. One
      layout, strings swapped by the fragment, and an optional primary action that is hidden when
      the cause is not actionable.
    -->
    <ScrollView
        android:id="@+id/fallbackPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:visibility="gone"
        android:fillViewport="true"
        tools:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/appBar"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!--
          fillViewport + wrap_content + gravity=center: the content sits centred when it fits and
          scrolls when it does not. Without the ScrollView, a large system font size pushes the
          action button off the bottom of a panel that is the only thing explaining why scanning
          is unavailable.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_camera_off"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/fallbackTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="@string/scan_permission_title" />

            <TextView
                android:id="@+id/fallbackBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                tools:text="@string/scan_permission_body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/fallbackAction"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                tools:text="@string/scan_permission_action" />
        </LinearLayout>
    </ScrollView>

    <!--
      Both exits from the scanner, always at the bottom, in every state. Manual entry is the
      vault’s real input path and scanning is the shortcut, so "Enter manually" is never
      something the user has to hunt for or back out of the screen to reach. They live in a
      LinearLayout rather than a constraint chain so that hiding the partial-result button
      collapses the gap instead of leaving one.
    -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/useResultButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/scan_action_use_partial"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/manualButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/scan_action_manual"
            app:icon="@drawable/ic_keyboard" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
